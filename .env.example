# KaushalDub backend settings. Copy to .env (never commit .env) and fill in. The backend reads ../.env and backend/.env.
# On the Hugging Face Space put the same names under Settings -> Variables and secrets.

# ---- Supabase (Auth with Google, Postgres, Storage). Project settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Only for older projects that still sign user tokens with the legacy HS256 JWT secret.
# New projects use asymmetric signing keys and the backend verifies them with the project's JWKS (leave empty).
SUPABASE_JWT_SECRET=

# ---- Platform provider keys (used only for free-trial jobs; users on "own keys" bring theirs)
SARVAM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# ---- Queue (Redis). Empty = jobs run inside the API process (local development only).
# Example (Upstash free tier, TLS): rediss://default:<password>@<host>:6379
REDIS_URL=
# true when the Kaggle/Colab GPU worker (notebooks/worker_gpu.ipynb) is running and should get local-model jobs
GPU_QUEUE_ENABLED=false
# let a CPU worker run Indic Parler-TTS / IndicConformer (very slow; normally leave false)
ALLOW_LOCAL_ON_CPU=false

# ---- Security
# Encrypts users' API keys. Generate once and keep it (changing it makes stored keys unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=
# Comma-separated frontend origins allowed by CORS (your Vercel URL + local dev)
CORS_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs, e.g. https://kaushaldub-.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Emails that see the platform budget / low-balance warning
ADMIN_EMAILS=
# Local development only. NEVER true in production.
DEV_AUTH=false
MOCK_PROVIDERS=false

# ---- Plans and budget
FREE_VIDEOS=5
# Monthly cap (INR) for jobs on the platform's keys; free-trial uploads stop when it is reached
PLATFORM_BUDGET_INR=500
LOW_BALANCE_WARN_RATIO=0.8
# Retrain automatically when this many approved corrections are waiting
RETRAIN_THRESHOLD=20
# Cost estimate rates (INR). Check Sarvam's pricing page.
RATE_SARVAM_STT_PER_MIN=0.49
RATE_SARVAM_MT_PER_10K=20
RATE_SARVAM_TTS_PER_10K=30

# ---- Step model
# bundle = ml/kaushaldub_model (config.json, model.pt, kd_model.py, kd_metrics.py); mock = demo recogniser
STEP_MODEL=bundle
# Optional: Hugging Face repo id holding the bundle, downloaded at startup if ml/kaushaldub_model/model.pt is missing
STEP_MODEL_REPO=
MODEL_BUNDLE_DIR=

# ---- Voices (check speaker names in Sarvam's docs for the model)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER_MALE=shubh
SARVAM_SPEAKER_FEMALE=ritu

# ---- Misc
# Public URL of this API (used for local-storage file links in development)
PUBLIC_API_URL=http://localhost:8000
DATA_DIR=
